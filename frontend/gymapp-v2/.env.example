# Mobil uygulama derleme degerleri - ORNEK. `.env` adiyla kopyalayip doldurun ve
# komuta dosyayi verin:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
# `.env` git'e GIRMEZ; bu ornek dosyada hicbir gercek deger bulunmaz.
#
# DIKKAT: satiri acip BOS birakmak degeri "bos metin" olarak tanimlar ve koddaki
# varsayilani ezer. Kullanmadiginiz satiri yorum olarak birakin.

# API sunucusu. Verilmezse Android emulatorunden host makineye cikan 10.0.2.2 kullanilir;
# ayni Wi-Fi'daki gercek cihaz icin bilgisayarin yerel IP'si yazilir.
# API_HOST=192.168.x.x
# Tam adres verilirse API_HOST'u ezer.
# API_BASE_URL=http://10.0.2.2:8082/api/v1

# Mobil Sentry DSN'i. Verilmezse hata raporlama hic baslatilmaz.
# SENTRY_DSN=

# true: hata raporlayici atlanir (uctan uca test kosulari).
# SKIP_CRASH_REPORTING=true

# Yalnizca integration_test icin; kaynakta varsayilan hesap yoktur.
# E2E_EMAIL=
# E2E_PASSWORD=
