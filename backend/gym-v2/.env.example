# Backend ortam degiskenleri - ORNEK. Bu dosyayi `.env` adiyla kopyalayip degerleri doldurun.
# `.env` git'e GIRMEZ; bu ornek dosyada hicbir gercek deger bulunmaz.
#
# docker compose -f backend/gym-v2/docker-compose.yml up -d
#   compose bu klasordeki `.env` dosyasini otomatik okur.

# --- Veritabani ---
# DB_URL ve DB_USERNAME yalnizca backend'i Maven/IDE'den calistirirken kullanilir;
# compose ikisini de kendisi verir (konteyner icinden `db:5432`).
DB_URL=jdbc:postgresql://localhost:5434/gymapp_v2
DB_USERNAME=gymapp_admin
DB_PASSWORD=

# --- Guvenlik ---
# Base64 kodlu, cozuldugunde en az 32 bayt. Uretmek icin: openssl rand -base64 48
JWT_SECRET=
# AES-256 anahtari: TAM 32 karakter. Degisirse mevcut sifreli kayitlar okunamaz.
ENCRYPTION_KEY=

# --- Dis servisler ---
GEMINI_API_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Yonetim paneli "Hatalar" ekrani (istege bagli). Bos birakilirsa ekran
# "yapilandirilmamis" der, panelin geri kalani calisir.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_BACKEND_PROJECT=
SENTRY_MOBILE_PROJECT=
SENTRY_BASE_URL=https://de.sentry.io

# --- Ilk yonetici hesabi (istege bagli) ---
# Yalnizca veritabaninda HIC yonetici yoksa acilista bir kez olusturulur; parola en az
# 10 karakter. Hesap olustuktan sonra bu iki satir silinebilir.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Web istemcisi ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,capacitor://localhost

# --- Izleme (Grafana, yalnizca 127.0.0.1:3001) ---
# Zorunlu: tanimli degilse compose acilmaz.
GRAFANA_PASSWORD=

# --- Istege bagli; verilmezse application.properties'teki varsayilan kullanilir ---
# SERVER_PORT=8082
# MANAGEMENT_PORT=9090
# FIREBASE_CREDENTIAL_PATH=classpath:firebase-adminsdk.json
# MIN_CLIENT_VERSION=1.0.0
# LATEST_CLIENT_VERSION=1.0.0

# --- Otomatik yedek (docker-compose.yml -> db-backup) ---
# Istege bagli. Cron ifadesi, saat dilimi Europe/Istanbul; verilmezse her gun 03:00.
# BACKUP_CRON=0 3 * * *
